     "who": "cloudy",
     "text": "Hello! I'm Cloudy. Aaah. I'm so sleepy."
    },
    {
     "who": "cloudy",
     "text": "I want to sleep up high with the big clouds. But I can't float up!"
    },
    {
     "who": "cloudy",
     "text": "Up, up, up! Oh no. Down I come again."
    }
