   "lines": [
    {
     "who": "ollie",
     "text": "That's it! Clouds are made of tiny drops of water. When a cloud is full, what falls down?",
     "pause": 2.0
    },
    {
     "who": "lulu",
     "text": "Rain! Drip, drop!"
    },
    {
     "who": "cloudy",
     "text": "But where can my rain go? I don't want to make my friends wet."
    },
    {
     "who": "honey",
     "text": "Look! Our flowers are droopy. They are thirsty!"
    },
    {
     "who": "ollie",
     "text": "How many thirsty flowers can you see? Count with me!",
     "pause": 2.0
    },
    {
     "who": "honey",
     "text": "One, two, three!"
    },
    {
     "who": "lulu",
     "text": "Red, yellow and... what color is the last one?",
     "pause": 2.0
    },
    {
     "who": "lulu",
     "text": "Blue!"
    }
   ]
