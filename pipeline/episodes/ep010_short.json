   "lines": [
    {
     "who": "dotty_beads",
     "text": "I have a tiny spot near my tail that makes a special oil."
    },
    {
     "who": "dotty_beads",
     "text": "I rub it on my feathers with my beak. Rub, rub, rub!"
    },
    {
     "who": "honey_rain",
     "text": "So the rain can't soak in! Your feathers are waterproof!"
    },
    {
