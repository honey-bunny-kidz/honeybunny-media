    {
     "who": "narrator",
     "text": "Honey Bunny Kidz presents: Lulu Lamb's Pumpkin Counting Song! Get your clapping hands ready!"
    }
   ]
  },
  {
   "bg": "autumn_porch",
   "cast": [
