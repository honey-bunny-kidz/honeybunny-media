   "lines": [
    {
     "who": "narrator",
     "text": "It was a cool autumn afternoon. Crunchy leaves danced on Honey's front porch."
    },
    {
     "who": "lulu",
     "text": "Mama Bunny, tomorrow is Dress-Up Day! Can we make the porch pretty?"
    },
    {
     "who": "mama",
     "text": "Yes, Lulu! Let's paint little pumpkins. We use soft brushes and paint. No cutting at all."
    },
    {
     "who": "lulu",
     "text": "Ooh! And I will make up a counting song. Every time we count, we clap!"
    },
    {
     "who": "lulu",
     "text": "Can you clap your hands with me? Ready?",
     "pause": 2.0
    },
    {
     "who": "sfx",
     "sfx": "clap",
     "text": "Clap! Clap!",
     "dur": 1.0,
     "pause": 0.5
    },
    {
     "who": "lulu",
     "text": "Yay! Great clapping!"
    }
   ]
  },
  {
   "bg": "autumn_porch",
   "cast": [
    {
     "id": "lulu",
     "x": 0.14
    },
    {
     "id": "honey",
     "x": 0.28
    },
    {
     "id": "p_happy",
     "x": 0.42,
     "y": 0.805,
     "scale": 1.6,
     "glow": true
    }
   ],
   "lines": [
    {
     "who": "narrator",
     "text": "Honey Bunny hopped up with a round, orange pumpkin."
    },
    {
     "who": "honey",
     "text": "I painted a big smile on mine! It's a happy face!"
    },
    {
     "who": "lulu",
     "text": "Can you make a happy face too? Show me your biggest smile!",
     "pause": 2.0
    },
    {
     "who": "lulu",
     "text": "What a lovely smile!"
    },
    {
     "who": "lulu",
     "text": "One little pumpkin, orange as the sun. Happy, happy face! Counting is fun!",
     "pause": 0.5
    },
    {
     "who": "sfx",
     "sfx": "clap",
     "text": "Clap! Clap!",
     "dur": 1.0,
     "pause": 0.5
    }
   ]
  },
