     "who": "lulu",
     "text": "What color is Dotty's pumpkin? Can you say it?",
     "pause": 2.0
    },
    {
     "who": "lulu",
     "text": "Yellow! Yes! A sunny yellow pumpkin."
    },
    {
     "who": "dotty",
     "text": "I painted a sleepy face. Yawn! It wants a nap."
    },
    {
     "who": "lulu",
     "text": "Two little pumpkins, one is yellow too. Sleepy, sleepy face! Yawn, like I do!",
     "pause": 0.5
    },
