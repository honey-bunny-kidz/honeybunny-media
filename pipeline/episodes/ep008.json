   "lines": [
    {
     "who": "lulu",
     "text": "Oh! My song needs five pumpkins. But I was so busy singing, I forgot to paint mine!"
    },
    {
     "who": "honey",
     "text": "That's okay, Lulu. We can help you!"
    },
    {
     "who": "narrator",
     "text": "Mama Bunny brought one more little coral pumpkin. Honey painted the eyes, Dotty painted the cheeks, and Mimi and Pip painted a giggly smile."
    },
    {
     "who": "lulu",
     "text": "Thank you, friends! When we help each other, it's even more fun."
    }
