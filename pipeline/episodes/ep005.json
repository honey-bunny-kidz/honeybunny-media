     "x": 0.46
    },
    {
     "id": "pip",
     "x": 0.62
    },
    {
     "id": "pumpkin_smile",
     "x": 0.77
    }
   ],
   "lines": [
    {
     "who": "narrator",
     "text": "Then the friends had a little pumpkin party song. Sing along!",
     "pause": 0.9
    },
    {
     "who": "narrator",
     "text": "Pumpkin, pumpkin, round and bright,",
     "pause": 0.5
    },
    {
     "who": "narrator",
     "text": "smiling in the autumn light.",
     "pause": 0.5
    },
    {
     "who": "narrator",
     "text": "Big ones, small ones, one, two, three,",
     "pause": 0.5
    },
    {
     "who": "narrator",
     "text": "share a pumpkin, friends with me!",
     "pause": 1.0
    },
    {
     "who": "dotty",
     "text": "Quack! Let's sing it again!",
     "pause": 0.6
    },
    {
     "who": "narrator",
     "text": "Pumpkin, pumpkin, round and bright,",
     "pause": 0.5
    },
    {
     "who": "narrator",
     "text": "smiling in the autumn light!",
     "pause": 1.0
    }
   ]
  },
  {
   "bg": "sunset",
   "cast": [
    {
     "id": "honey",
     "x": 0.3
    },
    {
     "id": "mama",
     "x": 0.6
    }
   ],
   "lines": [
    {
     "who": "narrator",
     "text": "The sun was going down. It was time to go home with Mama."
    },
    {
     "who": "mama",
     "text": "Let's take a big, slow breath. Smell the pumpkin pie.",
     "pause": 1.4
    },
    {
     "who": "mama",
     "text": "And blow out, slowly. Ahhh.",
     "pause": 1.2
    },
    {
     "who": "honey",
     "text": "Thank you, Mama. That was the best pumpkin party!"
    },
    {
     "who": "honey",
     "text": "What was your favorite part? The walking pumpkin? The smiley faces?",
     "pause": 2.0
    },
    {
     "who": "honey",
     "text": "I liked sharing with my friends the best!"
    }
   ]
  },
  {
   "bg": "sunset",
   "title": "The End",
   "subtitle": "Big or small, sharing makes us all happy!",
   "cast": [
    {
     "id": "honey",
     "x": 0.3
    },
    {
     "id": "pip",
     "x": 0.5
    },
