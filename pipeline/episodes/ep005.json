   ],
   "lead": 0.5,
   "tail": 1.6,
   "lines": [
    {
     "who": "narrator",
     "text": "Big or small, sharing makes us all happy. Bye bye, friends! See you next time on Honey Bunny Kidz!"
    }
   ]
  }
 ]
