   ],
   "lines": [
    {
     "who": "narrator",
     "text": "Every friend has a special sound. Loud or quiet, every sound is wonderful!"
    },
    {
     "who": "narrator",
     "text": "Share with a friend and subscribe to Honey Bunny Kidz!",
     "pause": 0.6
    },
    {
     "who": "ollie",
     "text": "Hoo, hoo! Goodnight! See you next time on Honey Bunny Kidz!",
     "pause": 1.2
    }
   ]
  }
