     "x": 0.5,
     "y": 0.77
    },
    {
     "id": "lulu",
     "x": 0.66
    },
    {
     "id": "pip",
     "x": 0.84
    }
   ],
   "lines": [
    {
     "who": "narrator",
     "text": "Now, all together!",
     "pause": 0.8
    },
    {
     "who": "narrator",
     "text": "Wiggle, waggle, one, two, three!",
     "pause": 0.5
    },
    {
     "who": "narrator",
     "text": "Make a sound and sing with me!",
     "pause": 0.5
    },
    {
     "who": "narrator",
     "text": "Flap and hop and turn around.",
     "pause": 0.5
    },
    {
     "who": "narrator",
     "text": "Every friend has a special sound!",
     "pause": 0.9
    }
   ]
  },
  {
   "bg": "dusk_stage",
   "cast": [
    {
     "id": "mimi",
     "x": 0.3
    },
    {
     "id": "ollie",
     "x": 0.5,
     "y": 0.77
    },
    {
     "id": "honey",
     "x": 0.75
    }
   ],
   "lines": [
    {
     "who": "mimi",
     "text": "Meow! I want to sing too!"
    },
    {
     "who": "narrator",
     "text": "Mimi Kitten says meow, meow.",
     "pause": 0.4
    },
    {
     "who": "narrator",
     "text": "Stretch up tall and take a bow!",
     "pause": 0.6
    },
    {
     "who": "mimi",
     "text": "Can you say meow, and take a little bow?",
     "pause": 2.0
    },
    {
     "who": "honey",
     "text": "Hmm. Everyone has a big sound. But bunnies are very quiet. What is my sound, Ollie?"
    }
   ]
  },
  {
   "bg": "dusk_stage",
   "cast": [
    {
     "id": "honey",
     "x": 0.3
    },
    {
     "id": "ollie",
     "x": 0.5,
     "y": 0.77
    }
   ],
   "lines": [
    {
     "who": "ollie",
     "text": "Hoo, hoo. I have very good ears, Honey. I know two bunny sounds!"
    },
    {
     "who": "ollie",
     "text": "Bunnies wiggle their little noses. Sniff, sniff. And bunnies talk with their back feet. Thump, thump!"
    },
    {
     "who": "honey",
     "text": "Thump, thump! I can do that! That is my special sound!"
    },
    {
     "who": "narrator",
     "text": "Honey Bunny wiggles her nose.",
     "pause": 0.4
    },
    {
     "who": "narrator",
     "text": "Thump, thump, thump, and up she goes!",
     "pause": 0.6
    },
    {
     "who": "honey",
     "text": "Can you wiggle your nose like a bunny, and stamp your foot? Thump, thump!",
     "pause": 2.0
    },
    {
     "who": "honey",
     "text": "Yay! Quiet sounds are special too!"
    }
   ]
  },
  {
   "bg": "dusk_stage",
   "cast": [
    {
     "id": "honey",
     "x": 0.09
    },
    {
     "id": "dotty",
     "x": 0.22
    },
    {
     "id": "mimi",
     "x": 0.35
    },
    {
