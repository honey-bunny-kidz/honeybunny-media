    {
     "id": "pip",
     "x": 0.84
    }
   ],
   "lines": [
    {
     "who": "narrator",
     "text": "Sing it one more time, little friends!",
     "pause": 0.8
    },
    {
     "who": "narrator",
     "text": "Wiggle, waggle, one, two, three!",
     "pause": 0.5
    },
    {
     "who": "narrator",
     "text": "Make a sound and sing with me!",
     "pause": 0.5
    },
    {
     "who": "narrator",
     "text": "Flap and hop and turn around.",
     "pause": 0.5
    },
    {
     "who": "narrator",
     "text": "Every friend has a special sound!",
     "pause": 0.9
    },
    {
     "who": "ollie",
     "text": "Which animal sound is your favorite? Hoo, baa, quack, woof, meow, or thump?",
     "pause": 2.0
    },
    {
     "who": "ollie",
     "text": "I like them all! Hoo, hoo!"
    }
   ]
  },
  {
   "bg": "dusk_stage",
   "cast": [
    {
     "id": "mama",
     "x": 0.2
    },
    {
     "id": "honey",
     "x": 0.34
    },
    {
     "id": "ollie",
     "x": 0.5,
     "y": 0.77
    },
    {
     "id": "lulu",
     "x": 0.7
    }
   ],
   "lines": [
    {
     "who": "narrator",
     "text": "The moon rose high and round. Mama Bunny came to walk the little friends home."
    },
    {
     "who": "mama",
     "text": "What a lovely song! Before we go, let's do a quiet owl breath."
    },
    {
     "who": "ollie",
     "text": "Breathe in slowly through your nose, and fill up like a fluffy owl.",
     "pause": 1.6
    },
    {
     "who": "ollie",
     "text": "And breathe out, soft as a feather. Hoo, hoo.",
     "pause": 1.6
    },
    {
     "who": "narrator",
     "text": "Wiggle, waggle, soft and slow.",
     "pause": 0.5
    },
    {
     "who": "narrator",
     "text": "Goodnight, friends, it's time to go.",
     "pause": 1.0
    }
   ]
  },
  {
   "bg": "dusk_stage",
   "tail": 1.8,
   "cast": [
