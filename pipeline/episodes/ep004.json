   "lines": [
    {
     "who": "narrator",
     "text": "Honey Bunny Kidz presents: The Wiggle Waggle Song! Sing along with Honey and friends!"
    }
   ]
  },
  {
   "bg": "meadow",
   "cast": [
    {
     "id": "honey",
     "x": 0.3
    },
    {
     "id": "pip",
     "x": 0.66
    }
   ],
   "lines": [
    {
     "who": "narrator",
     "text": "One sunny morning, Honey Bunny hopped to the rainbow meadow."
    },
    {
     "who": "narrator",
     "text": "There she met a new friend. A little puppy named Pip, with a waggy tail and a shiny blue collar."
    },
    {
     "who": "pip",
     "text": "Woof woof! Hello! I'm Pip! Do you want to play with me?"
    },
    {
     "who": "honey",
     "text": "Hello, Pip! Let's sing the Wiggle Waggle Song! Everyone can join in!"
    },
    {
     "who": "pip",
     "text": "Yay! How does it go?"
    },
    {
     "who": "honey",
     "text": "Each friend shows a fun move, and we all copy. Are you ready?"
    },
    {
     "who": "pip",
     "text": "Ready! Woof!"
    }
   ]
  },
  {
   "bg": "meadow",
   "cast": [
    {
     "id": "honey",
     "x": 0.12
    },
    {
     "id": "dotty",
     "x": 0.3
    },
    {
     "id": "mimi",
     "x": 0.5
    },
    {
     "id": "lulu",
     "x": 0.7
    },
    {
     "id": "pip",
     "x": 0.88
    }
   ],
   "lines": [
    {
     "who": "narrator",
     "text": "Here comes the song! Everybody, sing with us!",
     "pause": 0.9
    },
    {
     "who": "narrator",
     "text": "Wiggle, waggle, one, two, three!",
     "pause": 0.5
    },
    {
     "who": "narrator",
     "text": "Move your body, sing with me!",
     "pause": 0.5
    },
    {
     "who": "narrator",
     "text": "Clap your hands and turn around.",
     "pause": 0.5
    },
    {
     "who": "narrator",
     "text": "Then sit softly on the ground.",
     "pause": 0.9
    }
   ]
  },
  {
   "bg": "day",
   "cast": [
    {
     "id": "honey",
     "x": 0.35
    },
    {
     "id": "pip",
     "x": 0.68
    }
   ],
   "lines": [
    {
     "who": "honey",
     "text": "Me first! Watch me hop!"
    },
    {
     "who": "narrator",
     "text": "Honey Bunny hops so high.",
     "pause": 0.4
    },
    {
     "who": "narrator",
     "text": "Hop, hop, hop, up to the sky!",
     "pause": 0.6
    },
    {
     "who": "honey",
     "text": "Can you hop like me? Hop, hop, hop! One, two, three!"
    },
    {
     "who": "pip",
     "text": "Hop, hop, hop! I can do it too!"
    }
   ]
  },
  {
   "bg": "garden",
   "cast": [
    {
     "id": "dotty",
     "x": 0.3
    },
    {
     "id": "honey",
     "x": 0.5
    }
   ],
   "lines": [
    {
     "who": "dotty",
     "text": "Quack quack! My turn! Watch me waddle!"
    },
    {
     "who": "narrator",
     "text": "Dotty Duckling waddles slow.",
     "pause": 0.4
    },
    {
     "who": "narrator",
     "text": "Waddle, waddle, there we go!",
     "pause": 0.6
    },
    {
     "who": "dotty",
     "text": "Flap your arms like little wings! Quack, quack, quack, the duckling sings!"
    }
   ]
  },
  {
   "bg": "meadow",
