   "lines": [
    {
     "who": "pip",
     "text": "Now it's my turn! Woof woof!"
    },
    {
     "who": "narrator",
     "text": "Pip the Puppy wags his tail.",
     "pause": 0.4
    },
    {
     "who": "narrator",
     "text": "Wiggle, waggle, without fail!",
     "pause": 0.6
    },
    {
     "who": "pip",
     "text": "Wiggle your hips from side to side. Wiggle, waggle, nice and wide!"
    },
    {
     "who": "honey",
     "text": "Great wiggles, Pip! You are so good at waggling!"
    },
    {
     "who": "pip",
     "text": "Thank you, Honey! I'm so happy I have new friends!"
    }
   ]
