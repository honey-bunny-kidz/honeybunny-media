     "text": "Meow! My turn! I love to stretch!"
    },
    {
     "who": "narrator",
     "text": "Mimi Kitten stretches long.",
     "pause": 0.4
    },
    {
     "who": "narrator",
     "text": "Stretch up tall and hum our song.",
     "pause": 0.6
    },
    {
     "who": "mimi",
     "text": "Now tiptoe, tiptoe, soft and slow. Tiptoe, tiptoe, round we go!"
    }
   ]
  },
  {
   "bg": "day",
   "cast": [
    {
     "id": "lulu",
