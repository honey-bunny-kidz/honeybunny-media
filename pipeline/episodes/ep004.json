     "text": "Hopping, waddling, stretching, jumping, and wiggling."
    },
    {
     "who": "narrator",
     "text": "Every friend moves in their own special way. And every way is wonderful!"
    },
    {
     "who": "narrator",
     "text": "Now let's slow down, little friends. Take a big breath in.",
     "pause": 1.4
    },
    {
     "who": "narrator",
     "text": "And breathe out, slowly. Ahhh.",
     "pause": 1.0
    },
    {
