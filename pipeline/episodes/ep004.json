   ],
   "lines": [
    {
     "who": "lulu",
     "text": "Baa! My turn! I can jump!"
    },
    {
     "who": "narrator",
     "text": "Lulu Lamb jumps in the sun.",
     "pause": 0.4
    },
    {
     "who": "narrator",
     "text": "Jump, jump, jump! Oh, what fun!",
     "pause": 0.6
    },
    {
     "who": "lulu",
     "text": "Bounce like me, from one to three! Jump, jump, jump, and smile with me!"
    }
   ]
