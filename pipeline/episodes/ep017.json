   "lines": [
    {
     "who": "honey_pj",
     "text": "Now, the top teeth, and the bottom teeth!"
    },
    {
     "who": "narrator",
     "text": "Top teeth up, and bottom teeth down.",
     "pause": 0.4
    },
    {
     "who": "narrator",
     "text": "Wiggle your toothbrush, round and round!",
     "pause": 0.6
    },
    {
     "who": "sfx",
     "text": "",
     "pause": 0.3,
     "sfx": "brush",
     "dur": 1.4
    },
    {
     "who": "honey_pj",
     "text": "Can you brush your top teeth? Now your bottom teeth?",
     "pause": 2.0
    }
   ]
  },
  {
   "bg": "bathroom",
   "cast": [
    {
     "id": "mama",
     "x": 0.2
