   ],
   "lines": [
    {
     "who": "lulu",
     "text": "First, the front teeth! Show me a big smile!",
     "pause": 2.0
    },
    {
     "who": "narrator",
     "text": "Front teeth, front teeth, smile so wide.",
     "pause": 0.4
    },
    {
     "who": "narrator",
     "text": "Little circles, side to side!",
     "pause": 0.6
    },
    {
     "who": "lulu",
     "text": "Five little circles. Count with me! One, two, three, four, five!",
     "pause": 2.0
    }
   ]
  },
  {
   "bg": "bathroom",
   "cast": [
    {
     "id": "honey_pj",
