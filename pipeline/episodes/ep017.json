   "lines": [
    {
     "who": "mama",
     "text": "Last of all, spit the bubbles into the sink. Then a little sip of water, and swish."
    },
    {
     "who": "narrator",
     "text": "Spit, spit, swish, swish, all done.",
     "pause": 0.4
    },
    {
     "who": "narrator",
     "text": "Brushing teeth is so much fun!",
     "pause": 0.6
    },
    {
     "who": "lulu",
     "text": "Now let's look in the mirror. Honey, do I have a sparkly smile?"
    },
    {
     "who": "honey_pj",
     "text": "Yes! So sparkly! Can you show me your sparkly smile too?",
     "pause": 2.0
    }
   ]
  },
  {
