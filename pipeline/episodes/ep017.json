   ],
   "lines": [
    {
     "who": "mama",
     "text": "Now, the back teeth. They help us chew apples and carrots."
    },
    {
     "who": "narrator",
     "text": "Back teeth, chewing teeth, way inside.",
     "pause": 0.4
    },
    {
     "who": "narrator",
     "text": "Open your mouth, and open wide!",
     "pause": 0.6
    },
    {
     "who": "mama",
     "text": "Can you open wide, like a big yawn? Ahhh!",
     "pause": 2.0
    },
    {
     "who": "lulu",
     "text": "Ahhh! Brush, brush, way in the back!"
    }
   ]
  },
  {
