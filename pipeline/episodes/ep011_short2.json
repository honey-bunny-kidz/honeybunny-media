     "who": "mimi",
     "text": "How many kitty stretches can you do? Let's count to five!"
    },
    {
     "who": "mimi",
     "text": "Hands and knees, like a kitty cat. Back up high, like a hill. Then down, like a bowl."
    },
    {
     "who": "mimi",
     "text": "One. Up, and down.",
     "pause": 0.7
    },
