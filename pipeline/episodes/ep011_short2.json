     "who": "mimi",
     "text": "Two. Up, and down.",
     "pause": 0.7
    },
    {
     "who": "mimi",
     "text": "Three. Up, and down.",
     "pause": 0.7
    },
    {
     "who": "mimi",
     "text": "Four. Up, and down.",
     "pause": 0.7
    },
    {
     "who": "mimi",
     "text": "Five! You did five kitty stretches!"
    }
