   "lines": [
    {
     "who": "pip_cosy",
     "text": "Huh? My snow bunny was right here! Where did she go? Guess!",
     "pause": 2.0
    },
    {
     "who": "dotty_cosy",
     "text": "I see her yellow mittens in a puddle!"
    },
    {
     "who": "pip_cosy",
     "text": "Let's find out what happened. Come on!"
