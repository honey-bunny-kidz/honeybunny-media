     "who": "dotty_cosy",
     "text": "Can you see her long ears? Point to them!",
     "pause": 2.0
    },
    {
     "who": "pip_cosy",
     "text": "Then the sun came out. Is the sun warm or cold?",
     "pause": 2.0
    },
    {
     "who": "dotty_cosy",
     "text": "Warm! Lovely, warm sunshine."
    }
   ]
  },
  {
   "bg": "thaw_garden",
   "cast": [
